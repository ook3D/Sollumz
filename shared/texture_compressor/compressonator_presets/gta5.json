{
  "version": 1,
  "game": "gta5",
  "category": "texture_compressor_compressonator",
  "presets": [
    {
      "name": "Script Render Target",
      "data": {
        "pattern": "script_rt_*",
        "parameters": "",
        "args": "-fd ARGB_8888 -nomipmap",
        "args_alpha": ""
      }
    },
    {
      "name": "Normal",
      "data": {
        "pattern": "*_n, *_nm, *_nrm, *_normal",
        "parameters": "BumpSampler, BumpSampler2, BumpSampler_layer0, BumpSampler_layer1, BumpSampler_layer2, BumpSampler_layer3, DirtBumpSampler, PlateBgBumpSampler, FontNormalSampler, DetailNormalSampler, DetailNormal2Sampler, WrinkleSampler_A, WrinkleSampler_B, normalSampler",
        "args": "-fd BC1 -mipsize 4",
        "args_alpha": "-fd BC3 -mipsize 4"
      }
    },
    {
      "name": "Specular",
      "data": {
        "pattern": "*_s, *_sm, *_spec",
        "parameters": "SpecSampler, AnisoNoiseSpecSampler",
        "args": "-fd BC1 -mipsize 4",
        "args_alpha": "-fd BC3 -mipsize 4"
      }
    },
    {
      "name": "Detail",
      "data": {
        "pattern": "",
        "parameters": "DetailSampler",
        "args": "-fd BC5 -mipsize 4",
        "args_alpha": ""
      }
    },
    {
      "name": "Tint Palette",
      "data": {
        "pattern": "*_pal, *_dpal",
        "parameters": "TintPaletteSampler, TextureSamplerDiffPal",
        "args": "-fd ARGB_8888 -nomipmap",
        "args_alpha": ""
      }
    },
    {
      "name": "Distance Map",
      "data": {
        "pattern": "",
        "parameters": "distanceMapSampler",
        "args": "-fd ARGB_8888 -nomipmap",
        "args_alpha": ""
      }
    },
    {
      "name": "Cable",
      "data": {
        "pattern": "",
        "parameters": "textureSamp",
        "args": "-fd ARGB_8888 -mipsize 4",
        "args_alpha": ""
      }
    },
    {
      "name": "Diffuse",
      "data": {
        "pattern": "*_d, *_diff",
        "parameters": "DiffuseSampler, DiffuseSampler2, DiffuseSampler3, DiffuseExtraSampler, DiffuseHfSampler, PlateBgSampler, TextureSampler_layer0, TextureSampler_layer1, TextureSampler_layer2, TextureSampler_layer3, SnowSampler, SnowSampler0, SnowSampler1, DirtSampler",
        "args": "-fd BC1 -mipsize 4",
        "args_alpha": "-fd BC3 -mipsize 4"
      }
    },
    {
      "name": "Default",
      "data": {
        "pattern": "",
        "parameters": "",
        "args": "-fd BC1 -mipsize 4",
        "args_alpha": "-fd BC3 -mipsize 4"
      }
    }
  ]
}
