{
  "version": 1,
  "game": "rdr2",
  "category": "texture_compressor_nvtt",
  "presets": [
    {
      "name": "Script Render Target",
      "data": {
        "pattern": "script_rt_*",
        "parameters": "",
        "args": "--format bgra8 --no-mips",
        "args_alpha": ""
      }
    },
    {
      "name": "Tint Palette",
      "data": {
        "pattern": "*_pal",
        "parameters": "TintPaletteTex, vehTintPaletteTex",
        "args": "--format bgra8 --dx10 --export-transfer-function srgb --no-mips",
        "args_alpha": ""
      }
    },
    {
      "name": "Albedo Palette",
      "data": {
        "pattern": "",
        "parameters": "albedoPaletteTex",
        "args": "--format rgba8 --dx10 --export-transfer-function srgb --mips --min-mip-size 4 --mip-filter box --no-mip-pre-alpha",
        "args_alpha": ""
      }
    },
    {
      "name": "Normal",
      "data": {
        "pattern": "*_nm, *_n, *_normal, *_normals",
        "parameters": "BumpTex, bumpTexture, bumpTexture2, BumpTexture_layer0, BumpTexture_layer1, BumpTexture_layer2, BumpTexture_layer3, lyr0NormalTex, lyr1NormalTex, WrinkleTexture, VehWrinkleTexture, tintBumpTexture",
        "args": "--format bc1 --weight-b 0 --bias-b 1 --mips --min-mip-size 4 --mip-filter box --no-mip-gamma-correct --no-mip-pre-alpha",
        "args_alpha": "--format bc3 --weight-b 0 --bias-b 1 --mips --min-mip-size 4 --mip-filter box --no-mip-gamma-correct --no-mip-pre-alpha"
      }
    },
    {
      "name": "Material",
      "data": {
        "pattern": "*_ma, *_mb, *_matb, *_s",
        "parameters": "SpecularTex, SpecularTex2, SpecularTexture, SpecularTexture2, anisoNoiseSpecTexture, lyr0MaterialATex, lyr1MaterialATex, lyr0MaterialBTex, lyr1MaterialBTex, MaterialMapATexture_layer0, MaterialMapATexture_layer1, MaterialMapATexture_layer2, MaterialMapATexture_layer3, MaterialBTexture, MaterialBTexture2",
        "args": "--format bc1 --mips --min-mip-size 4 --mip-filter box --no-mip-gamma-correct --no-mip-pre-alpha",
        "args_alpha": "--format bc3 --mips --min-mip-size 4 --mip-filter box --no-mip-gamma-correct --no-mip-pre-alpha"
      }
    },
    {
      "name": "Lookup",
      "data": {
        "pattern": "",
        "parameters": "lookupTexture",
        "args": "--format bc1 --no-mips",
        "args_alpha": "--format bc3 --no-mips"
      }
    },
    {
      "name": "Albedo",
      "data": {
        "pattern": "*_ab, *_abal, *_al, *_a, *_abte, *_d, *_dirt",
        "parameters": "DiffuseTex, DiffuseTex2, dirtDiffuseTex, lyr0DiffuseTex, lyr1DiffuseTex, DiffuseTexture_layer0, DiffuseTexture_layer1, DiffuseTexture_layer2, DiffuseTexture_layer3, tintTexture",
        "args": "--format bc1 --dx10 --export-transfer-function srgb --mips --min-mip-size 4 --mip-filter box --no-mip-pre-alpha",
        "args_alpha": "--format bc3 --dx10 --export-transfer-function srgb --mips --min-mip-size 4 --mip-filter box --no-mip-pre-alpha"
      }
    },
    {
      "name": "Default",
      "data": {
        "pattern": "",
        "parameters": "",
        "args": "--format bc1 --mips --min-mip-size 4 --mip-filter box --no-mip-gamma-correct --no-mip-pre-alpha",
        "args_alpha": "--format bc3 --mips --min-mip-size 4 --mip-filter box --no-mip-gamma-correct --no-mip-pre-alpha"
      }
    }
  ]
}
